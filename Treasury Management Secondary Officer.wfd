              <jesw1:OdbcActivity DesignerErrors="{x:Null}" ReportableDetails="{x:Null}" ActivityName="Pull Account Info from SecondaryOfficer dbo" sap2010:Annotation.AnnotationText="Variables: AcctId, New Secondary Officer, New Secondary Officer Name" DisplayName="Import Data from DB" sap2010:WorkflowViewState.IdRef="OdbcActivity_1" InternalIdentifierKey="00000000-0000-0000-0000-000000000000" OdbcName="WFImport" Statement="SELECT TOP (1) &#xA;      [Acct # (DDMA)]&#xA;      ,[New Secondary Officer]&#xA;      ,[New Secondary Officer Name]&#xA;  FROM [dbo].[SecondaryOfficer]" VariableMap="&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;ArrayOfDataQueryVariableMap xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot;&gt;&lt;DataQueryVariableMap&gt;&lt;VariableName&gt;&amp;lt;%&amp;lt;%AcctId%&amp;gt;%&amp;gt;&lt;/VariableName&gt;&lt;ReaderColumnName&gt;Acct # (DDMA)&lt;/ReaderColumnName&gt;&lt;ShouldEvaluate&gt;false&lt;/ShouldEvaluate&gt;&lt;/DataQueryVariableMap&gt;&lt;DataQueryVariableMap&gt;&lt;VariableName&gt;&amp;lt;%&amp;lt;%OffCode%&amp;gt;%&amp;gt;&lt;/VariableName&gt;&lt;ReaderColumnName&gt;New Secondary Officer&lt;/ReaderColumnName&gt;&lt;ShouldEvaluate&gt;false&lt;/ShouldEvaluate&gt;&lt;/DataQueryVariableMap&gt;&lt;DataQueryVariableMap&gt;&lt;VariableName&gt;&amp;lt;%&amp;lt;%NewOffName%&amp;gt;%&amp;gt;&lt;/VariableName&gt;&lt;ReaderColumnName&gt;New Secondary Officer Name&lt;/ReaderColumnName&gt;&lt;ShouldEvaluate&gt;false&lt;/ShouldEvaluate&gt;&lt;/DataQueryVariableMap&gt;&lt;/ArrayOfDataQueryVariableMap&gt;">
                <jesw1:OdbcActivity.DesignerMappingData>
                  <scg3:List x:TypeArguments="jeta:DataQueryVariableMap" Capacity="4">
                    <jeta:DataQueryVariableMap ReaderValue="{x:Null}" ReaderColumnName="Acct # (DDMA)" ShouldEvaluate="False" VariableName="&lt;%AcctId%&gt;" />
                    <jeta:DataQueryVariableMap ReaderValue="{x:Null}" ReaderColumnName="New Secondary Officer" ShouldEvaluate="False" VariableName="&lt;%OffCode%&gt;" />
                    <jeta:DataQueryVariableMap ReaderValue="{x:Null}" ReaderColumnName="New Secondary Officer Name" ShouldEvaluate="False" VariableName="&lt;%NewOffName%&gt;" />
                  </scg3:List>
                </jesw1:OdbcActivity.DesignerMappingData>
              </jesw1:OdbcActivity>
              <p:FlowStep.Next>
                <p:FlowDecision x:Name="__ReferenceID8" Condition="[AcctId=&quot;&quot;]" DisplayName="Check if Table is Empty" sap2010:WorkflowViewState.IdRef="FlowDecision_3">
                  <p:FlowDecision.True>
                    <p:FlowDecision x:Name="__ReferenceID9" Condition="[FaultCount=0]" sap2010:WorkflowViewState.IdRef="FlowDecision_1">
                      <p:FlowDecision.True>
                        <p:FlowStep x:Name="__ReferenceID0" sap2010:WorkflowViewState.IdRef="FlowStep_8">
                          <jesw1:ActivityEmail DesignerErrors="{x:Null}" ReportableDetails="{x:Null}" sap2010:Annotation.AnnotationText="Brian.Murphy@southside.com, David.braswell@southside.com, and Jared.Green@southside.com  " DisplayName="Email - Treasury Management Dist Group" EmailAddressTo="ross.staples@southside.com" EmailBody="&lt;h1 style=&quot;font-size:8vw&quot;&gt;-Secondary Officer Workflow Results-&lt;/h1&gt;&lt;h2 style=&quot;font-size:5vw&quot;&gt;Successful:  &lt;font style=&quot;color:#66CC66;&quot;&gt;&lt;%SuccessCount%&gt;&lt;/font&gt;&lt;/h2&gt; &lt;h2 style=&quot;font-size:5vw&quot;&gt;Faulted: &lt;font style =&quot;color:#FF2626;&quot;&gt;&lt;%FaultCount%&gt;&lt;/font&gt;&lt;/h2&gt;" EmailSubject="Secondary Officer Maintenance Summary" sap2010:WorkflowViewState.IdRef="ActivityEmail_1" InternalIdentifierKey="00000000-0000-0000-0000-000000000000" OverrideTemplate="True">
                            <jesw1:ActivityEmail.EmailTemplate>
                              <p:InArgument x:TypeArguments="x:String" />
                            </jesw1:ActivityEmail.EmailTemplate>
                          </jesw1:ActivityEmail>
                        </p:FlowStep>
                      </p:FlowDecision.True>
                      <p:FlowDecision.False>
                        <p:FlowStep x:Name="__ReferenceID10" sap2010:WorkflowViewState.IdRef="FlowStep_9">
                          <jesw1:ActivityEmail DesignerErrors="{x:Null}" ReportableDetails="{x:Null}" sap2010:Annotation.AnnotationText="CIF@southside.com and Brian.Murphy@southside.com " DisplayName="Email CIF - Faulted Accounts" EmailAddressTo="ross.staples@southside.com" EmailBody="&lt;h1 style=&quot;font-size:8vw&quot;&gt;-Secondary Officer Summary-&lt;/h1&gt;&lt;h2 style=&quot;font-size:5vw&quot;&gt;Faulted: &lt;font style =&quot;color:#FF2626;&quot;&gt;&lt;%FaultCount%&gt;&lt;/font&gt;&lt;/h2&gt;&lt;h2 style=&quot;font-size:5vw; margin:0&quot;&gt;The accounts listed below were unable to add a secondary officer&lt;/h2&gt;&lt;h2 style=&quot;font-size:5vw; margin:0&quot;&gt;&#xA;Please complete the following steps:&#xA;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;1. Maintenance under DD Menu -&gt; Deposit Master File Maintenance -&gt; Officer List -&gt; Option 10&#xA;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;2. Choose Option 10 -&gt; Officer List&#xA;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;3. Find Officer needed and click Select&lt;/h2&gt;&#xA;&#xA; &lt;%FailDisplay%&gt;" EmailSubject="Secondary Officer Maintenance Summary" sap2010:WorkflowViewState.IdRef="ActivityEmail_2" InternalIdentifierKey="00000000-0000-0000-0000-000000000000" OverrideTemplate="True">
                            <jesw1:ActivityEmail.EmailTemplate>
                              <p:InArgument x:TypeArguments="x:String" />
                            </jesw1:ActivityEmail.EmailTemplate>
                          </jesw1:ActivityEmail>
                          <p:FlowStep.Next>
                            <x:Reference>__ReferenceID0</x:Reference>
                          </p:FlowStep.Next>
                        </p:FlowStep>
                      </p:FlowDecision.False>
                    </p:FlowDecision>
                  </p:FlowDecision.True>
                  <p:FlowDecision.False>
                    <p:FlowStep x:Name="__ReferenceID3" sap2010:WorkflowViewState.IdRef="FlowStep_2">
                      <jesw1:ServiceGatewayClientActivity ReportableDetails="{x:Null}" helper="{x:Null}" ActionUri="http://jackhenry.com/ws/AcctMod" DisplayName="AcctMod - Add Secondary Officer" FaultTransformationBody="&lt;xsl:stylesheet version=&quot;1.0&quot; xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:p1=&quot;http://jackhenry.com/jxchange/TPG/2008&quot; xmlns:s=&quot;http://www.w3.org/2003/05/soap-envelope&quot; xmlns:soap=&quot;http://schemas.xmlsoap.org/soap/envelope/&quot;&gt;&#xA; &lt;xsl:output omit-xml-declaration=&quot;yes&quot; indent=&quot;yes&quot;/&gt;&#xA; &lt;xsl:template match=&quot;/&quot;&gt;&#xA;  &lt;xsl:choose&gt;&#xA;   &lt;xsl:when test=&quot;(/s:Envelope/s:Body/s:Fault/s:Detail/p1:HdrFault/p1:FaultRecInfoArray)&quot;&gt;&#xA;    &lt;ActivityClientFault&gt;&#xA;  &lt;!--FaultWorkflow=&quot;true&quot; will fault workflow and send to faulted monitor if error occurs.--&gt;&#xA;  &lt;!--FaultWorkflow=&quot;false&quot; will populate the 'FaultDetails' variable and let the workflow decide what to do--&gt;&#xA;     &lt;FaultWorkflow&gt;false&lt;/FaultWorkflow&gt; &#xA;     &lt;Reason&gt;Message Faulted&lt;/Reason&gt;&#xA;     &lt;Code/&gt;&#xA;     &lt;SubCode&gt;&#xA;      &lt;xsl:for-each select=&quot;s:Envelope/s:Body/s:Fault/s:Detail/p1:HdrFault/p1:FaultRecInfoArray/p1:FaultMsgRec&quot;&gt;&#xA;       &lt;xsl:text&gt;&amp;#10;&lt;/xsl:text&gt;*Desc: &lt;xsl:value-of select=&quot;p1:ErrDesc&quot;/&gt;/&gt;&#xA;      &lt;/xsl:for-each&gt;&#xA;     &lt;/SubCode&gt;&#xA;    &lt;Details&gt;&#xA;     &lt;xsl:for-each select=&quot;s:Envelope/s:Body/s:Fault/s:Detail/p1:HdrFault/p1:FaultRecInfoArray/p1:FaultMsgRec&quot;&gt;     &#xA;     Fault Desc: &lt;xsl:value-of select=&quot;p1:ErrDesc&quot;/&gt;&#xA;     &lt;/xsl:for-each&gt;&#xA;     &lt;/Details&gt;&#xA;    &lt;DetailsVariable&gt;FaultDetails&lt;/DetailsVariable&gt;&#xA;    &lt;/ActivityClientFault&gt;&#xA;   &lt;/xsl:when&gt;&#xA;   &lt;xsl:when test=&quot;(/soap:Envelope/soap:Body/soap:Fault/faultcode)&quot;&gt;&#xA;    &lt;ActivityClientFault&gt;&#xA;  &lt;!--FaultWorkflow=&quot;true&quot; will fault workflow and send to faulted monitor if error occurs.--&gt;&#xA;  &lt;!--FaultWorkflow=&quot;false&quot; will populate the 'FaultDetails' variable and let the workflow decide what to do--&gt;&#xA;     &lt;FaultWorkflow&gt;false&lt;/FaultWorkflow&gt; &#xA;     &lt;Reason&gt;Message Faulted&lt;/Reason&gt;&#xA;     &lt;Code/&gt;&#xA;     &lt;SubCode&gt;&#xA;      &lt;xsl:for-each select=&quot;soap:Envelope/soap:Body/soap:Fault&quot;&gt;&#xA;       &lt;xsl:text&gt;&amp;#10;&lt;/xsl:text&gt;* &lt;xsl:value-of select=&quot;faultcode&quot;/&gt;: &lt;xsl:value-of select=&quot;detail/ErrorCode&quot;/&gt; | fault: &lt;xsl:value-of select=&quot;faultstring&quot;/&gt; | Solution: &lt;xsl:value-of select=&quot;detail/ProposedSolution&quot;/&gt;&#xA;      &lt;/xsl:for-each&gt;&#xA;     &lt;/SubCode&gt;&#xA;    &lt;Details&gt;&#xA;     &lt;xsl:for-each select=&quot;soap:Envelope/soap:Body/soap:Fault&quot;&gt;      faultcode: &lt;xsl:value-of select=&quot;faultcode&quot;/&gt;&#xA;      faultstring: &lt;xsl:value-of select=&quot;faultstring&quot;/&gt;&#xA;      ErrorCode: &lt;xsl:value-of select=&quot;detail/ErrorCode&quot;/&gt;&#xA;      ProposedSolution: &lt;xsl:value-of select=&quot;detail/ProposedSolution&quot;/&gt;&#xA;      &lt;xsl:if test=&quot;position()!=last()&quot;&gt;&lt;xsl:text&gt;&amp;#10;&amp;#10;&lt;/xsl:text&gt;&lt;/xsl:if&gt;&#xA;     &lt;/xsl:for-each&gt;&#xA;     &lt;/Details&gt;&#xA;    &lt;DetailsVariable&gt;FaultDetails&lt;/DetailsVariable&gt;&#xA;    &lt;/ActivityClientFault&gt;&#xA;   &lt;/xsl:when&gt;&#xA;   &lt;xsl:otherwise&gt;&#xA;    &lt;ActivityClientFault&gt;&#xA;     &lt;FaultWorkflow&gt;false&lt;/FaultWorkflow&gt;&#xA;     &lt;Code/&gt;&#xA;     &lt;CodeVariable/&gt;&#xA;     &lt;Details/&gt;&#xA;     &lt;DetailsVariable/&gt;&#xA;     &lt;strErrCat/&gt;&#xA;     &lt;ErrCatVariable/&gt;&#xA;    &lt;/ActivityClientFault&gt;&#xA;   &lt;/xsl:otherwise&gt;&#xA;  &lt;/xsl:choose&gt;&#xA; &lt;/xsl:template&gt;&#xA;&lt;/xsl:stylesheet&gt;" sap2010:WorkflowViewState.IdRef="ServiceGatewayClientActivity_1" InternalIdentifierKey="00000000-0000-0000-0000-000000000000" MessageBody="&lt;AcctMod xmlns=&quot;http://jackhenry.com/jxchange/TPG/2008&quot;&gt;&#xA;                              &lt;MsgRqHdr&gt;&#xA;                                        &lt;jXchangeHdr&gt;&#xA;                                                  &lt;JxVer&gt;2022.0.02&lt;/JxVer&gt;&#xA;                                                  &lt;AuditUsrId&gt;AuditUsrId1&lt;/AuditUsrId&gt;&#xA;                                                  &lt;AuditWsId&gt;AuditWsId1&lt;/AuditWsId&gt;&#xA;                                        &lt;/jXchangeHdr&gt;&#xA;                              &lt;/MsgRqHdr&gt;&#xA;&lt;ErrOvrRdInfoArray&gt;&#xA;                                        &lt;ErrOvrRd&gt;&#xA;                                                  &lt;ErrCode&gt;100344&lt;/ErrCode&gt;&#xA;                                        &lt;/ErrOvrRd&gt;&#xA;                              &lt;/ErrOvrRdInfoArray&gt;&#xA;                              &lt;AccountId&gt;&#xA;                                        &lt;AcctId&gt;&lt;%AcctId%&gt;&lt;/AcctId&gt;&#xA;                                        &lt;AcctType&gt;D&lt;/AcctType&gt;&#xA;                              &lt;/AccountId&gt;&#xA;                              &lt;DepMod&gt;&#xA;                                        &lt;DepInfoRec&gt;&#xA;                                                  &lt;OffInfoArray&gt;&#xA;                                                            &lt;OffInfoRec&gt;&#xA;                                                                      &lt;OffCode&gt;&lt;%OffCode%&gt;&lt;/OffCode&gt;&#xA;                   SerChgWavRsnCode JHANull=&quot;true&quot; /&gt;&#xA;                                                            &lt;/OffInfoRec&gt;&#xA;                                                  &lt;/OffInfoArray&gt;&#xA;                                        &lt;/DepInfoRec&gt;&#xA;                                        &lt;DepRateIntInfo&gt;&#xA;                                                  &lt;VarIntRateInfo&gt;&#xA;                                                            &lt;PrimeRateIdx&gt;&lt;/PrimeRateIdx&gt;&#xA;                                                  &lt;/VarIntRateInfo&gt;&#xA;                                        &lt;/DepRateIntInfo&gt;&#xA;                              &lt;/DepMod&gt;&#xA;                              &lt;TimeDepMod&gt;&#xA;                                        &lt;TimeDepRateIntInfo&gt;&#xA;                                                  &lt;VarIntRateInfo&gt;&#xA;                                                            &lt;PrimeRateIdx&gt;&lt;/PrimeRateIdx&gt;&#xA;                                                  &lt;/VarIntRateInfo&gt;&#xA;                                                  &lt;MultiDepRateArray&gt;&#xA;                                                            &lt;MultiDepRateRec&gt;&#xA;                                                                      &lt;DepEffDt&gt;&lt;/DepEffDt&gt;&#xA;                                                            &lt;/MultiDepRateRec&gt;&#xA;                                                            &lt;MultiDepRateRec&gt;&#xA;                                                                      &lt;DepEffDt&gt;&lt;/DepEffDt&gt;&#xA;                                                            &lt;/MultiDepRateRec&gt;&#xA;                                                  &lt;/MultiDepRateArray&gt;&#xA;                                        &lt;/TimeDepRateIntInfo&gt;&#xA;                              &lt;/TimeDepMod&gt;&#xA;                              &lt;TrckMod&gt;&#xA;                                        &lt;TrckAcctInfo&gt;&#xA;                                                  &lt;Term&gt;&#xA;                                                            &lt;TermCnt&gt;&lt;/TermCnt&gt;&#xA;                                                            &lt;TermUnits&gt;&lt;/TermUnits&gt;&#xA;                                                  &lt;/Term&gt;&#xA;                                        &lt;/TrckAcctInfo&gt;&#xA;                              &lt;/TrckMod&gt;&#xA;                              &lt;LnMod&gt;&#xA;                                        &lt;LnInfoRec&gt;&#xA;                                                  &lt;Term&gt;&#xA;                                                            &lt;TermCnt&gt;&lt;/TermCnt&gt;&#xA;                                                            &lt;TermUnits&gt;&lt;/TermUnits&gt;&#xA;                                                  &lt;/Term&gt;&#xA;                                        &lt;/LnInfoRec&gt;&#xA;                                        &lt;LnProtInfo&gt;&#xA;                                                  &lt;ProtAcctArray&gt;&#xA;                                                            &lt;ProtAcctRec&gt;&#xA;                                                                      &lt;ProtAcctId&gt;&lt;/ProtAcctId&gt;&#xA;                                                            &lt;/ProtAcctRec&gt;&#xA;                                                            &lt;ProtAcctRec&gt;&#xA;                                                                      &lt;ProtAcctId&gt;&lt;/ProtAcctId&gt;&#xA;                                                            &lt;/ProtAcctRec&gt;&#xA;                                                  &lt;/ProtAcctArray&gt;&#xA;                                        &lt;/LnProtInfo&gt;&#xA;                                        &lt;LnRegRptInfo&gt;&#xA;                                                  &lt;LnRiskRateArray&gt;&#xA;                                                            &lt;LnRiskRateInfoRec&gt;&#xA;                                                                      &lt;RiskRateText&gt;&lt;/RiskRateText&gt;&#xA;                                                            &lt;/LnRiskRateInfoRec&gt;&#xA;                                                            &lt;LnRiskRateInfoRec&gt;&#xA;                                                                      &lt;RiskRateText&gt;&lt;/RiskRateText&gt;&#xA;                                                            &lt;/LnRiskRateInfoRec&gt;&#xA;                                                  &lt;/LnRiskRateArray&gt;&#xA;                                        &lt;/LnRegRptInfo&gt;&#xA;                              &lt;/LnMod&gt;&#xA;                    &lt;/AcctMod&gt;" MessageTemplate="AcctMod" OverrideTemplate="True" TransformationBody="&lt;?xml version='1.0'?&gt;&#xA;&lt;xsl:stylesheet version=&quot;1.0&quot; xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:a=&quot;http://jackhenry.com/jxchange/TPG/2008&quot; xmlns:s=&quot;http://www.w3.org/2003/05/soap-envelope&quot;&gt;&#xA; &lt;xsl:template match=&quot;/&quot;&gt;&#xA;    &lt;WorkflowTranslatedResponse&gt;&#xA;    &#xA;   &lt;VariableMap&gt;&#xA;&#xA;    &lt;ActivityMapVariable&gt;&#xA;     &lt;VariableName&gt;RsStat&lt;/VariableName&gt;&#xA;     &lt;Value&gt;&#xA;      &lt;xsl:value-of select=&quot;s:Envelope/s:Body/a:AcctModResponse/a:RsStat&quot;/&gt;&#xA;     &lt;/Value&gt;&#xA;    &lt;/ActivityMapVariable&gt;&#xA;    &#xA;    &lt;ActivityMapVariable&gt;&#xA;     &lt;VariableName&gt;WarningDetails&lt;/VariableName&gt;&#xA;     &lt;Value&gt;&#xA;      &lt;xsl:for-each select=&quot;s:Envelope/s:Body/*/a:MsgRsHdr/a:MsgRecInfoArray/a:MsgRec&quot;&gt;Response Received:&#xA;       Code: &lt;xsl:value-of select=&quot;a:ErrCode&quot;/&gt;&#xA;       Cat: &lt;xsl:value-of select=&quot;a:ErrCat&quot;/&gt;&#xA;       Desc: &lt;xsl:value-of select=&quot;a:ErrDesc&quot;/&gt;&#xA;       Elem: &lt;xsl:value-of select=&quot;a:ErrElem&quot;/&gt;&#xA;       ElemVal: &lt;xsl:value-of select=&quot;a:ErrElemVal&quot;/&gt;&#xA;       Loc: &lt;xsl:value-of select=&quot;a:ErrLoc&quot;/&gt;&#xA;      &lt;xsl:if test=&quot;position()!=last()&quot;&gt;&lt;xsl:text&gt;&amp;#10;&amp;#10;&lt;/xsl:text&gt;&lt;/xsl:if&gt;&#xA;      &lt;/xsl:for-each&gt;&#xA;     &lt;/Value&gt;&#xA;    &lt;/ActivityMapVariable&gt; &#xA;   &#xA;   &lt;/VariableMap&gt;&#xA;  &lt;/WorkflowTranslatedResponse&gt; &#xA; &lt;/xsl:template&gt;&#xA;&lt;/xsl:stylesheet&gt;">
                        <jesw1:ServiceGatewayClientActivity.BaseUri>
                          <p:InArgument x:TypeArguments="x:String" />
                        </jesw1:ServiceGatewayClientActivity.BaseUri>
                      </jesw1:ServiceGatewayClientActivity>
                      <p:FlowStep.Next>
                        <p:FlowDecision x:Name="__ReferenceID4" Condition="[RsStat=&quot;Success&quot;]" sap2010:WorkflowViewState.IdRef="FlowDecision_2">
                          <p:FlowDecision.True>
                            <p:FlowStep x:Name="__ReferenceID5" sap2010:WorkflowViewState.IdRef="FlowStep_5">
                              <jesw1:JHAAssign DesignerErrors="{x:Null}" ReportableDetails="{x:Null}" DisplayName="Assign" sap2010:WorkflowViewState.IdRef="JHAAssign_2" InternalIdentifierKey="00000000-0000-0000-0000-000000000000">
                                <jesw1:JHAAssign.To>
                                  <p:OutArgument x:TypeArguments="x:Int32">[SuccessCount]</p:OutArgument>
                                </jesw1:JHAAssign.To>
                                <jesw1:JHAAssign.Value>
                                  <p:InArgument x:TypeArguments="x:Int32">[SuccessCount+1]</p:InArgument>
                                </jesw1:JHAAssign.Value>
                              </jesw1:JHAAssign>
                              <p:FlowStep.Next>
                                <p:FlowStep x:Name="__ReferenceID2" sap2010:WorkflowViewState.IdRef="FlowStep_12">
                                  <jesw1:OdbcActivity DesignerErrors="{x:Null}" ReportableDetails="{x:Null}" ActivityName="Delete Top Account" DisplayName="Delete Top Account" sap2010:WorkflowViewState.IdRef="OdbcActivity_2" InternalIdentifierKey="00000000-0000-0000-0000-000000000000" OdbcName="WFImport" Statement="DELETE TOP (1)&#xA;FROM [dbo].[SecondaryOfficer]" VariableMap="&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;&lt;ArrayOfDataQueryVariableMap xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; /&gt;">
                                    <jesw1:OdbcActivity.DesignerMappingData>
                                      <scg3:List x:TypeArguments="jeta:DataQueryVariableMap" Capacity="0" />
                                    </jesw1:OdbcActivity.DesignerMappingData>
                                  </jesw1:OdbcActivity>
                                  <p:FlowStep.Next>
                                    <p:FlowStep x:Name="__ReferenceID11" sap2010:WorkflowViewState.IdRef="FlowStep_10">
                                      <p:Sequence DisplayName="Clear Variables" sap2010:WorkflowViewState.IdRef="Sequence_1">
                                        <jesw1:JHAAssign DesignerErrors="{x:Null}" ReportableDetails="{x:Null}" DisplayName="Assign" sap2010:WorkflowViewState.IdRef="JHAAssign_5" InternalIdentifierKey="00000000-0000-0000-0000-000000000000">
                                          <jesw1:JHAAssign.To>
                                            <p:OutArgument x:TypeArguments="x:String">[AcctId]</p:OutArgument>
                                          </jesw1:JHAAssign.To>
                                          <jesw1:JHAAssign.Value>
                                            <p:InArgument x:TypeArguments="x:String">
                                              <p:Literal x:TypeArguments="x:String" Value="" />
                                            </p:InArgument>
                                          </jesw1:JHAAssign.Value>
                                        </jesw1:JHAAssign>
                                        <jesw1:JHAAssign DesignerErrors="{x:Null}" ReportableDetails="{x:Null}" DisplayName="Assign" sap2010:WorkflowViewState.IdRef="JHAAssign_6" InternalIdentifierKey="00000000-0000-0000-0000-000000000000">
                                          <jesw1:JHAAssign.To>
                                            <p:OutArgument x:TypeArguments="x:String">[OffCode]</p:OutArgument>
                                          </jesw1:JHAAssign.To>
                                          <jesw1:JHAAssign.Value>
                                            <p:InArgument x:TypeArguments="x:String">
                                              <p:Literal x:TypeArguments="x:String" Value="" />
                                            </p:InArgument>
                                          </jesw1:JHAAssign.Value>
                                        </jesw1:JHAAssign>
                                        <jesw1:JHAAssign DesignerErrors="{x:Null}" ReportableDetails="{x:Null}" DisplayName="Assign" sap2010:WorkflowViewState.IdRef="JHAAssign_7" InternalIdentifierKey="00000000-0000-0000-0000-000000000000">
                                          <jesw1:JHAAssign.To>
                                            <p:OutArgument x:TypeArguments="x:String">[NewOffName]</p:OutArgument>
                                          </jesw1:JHAAssign.To>
                                          <jesw1:JHAAssign.Value>
                                            <p:InArgument x:TypeArguments="x:String">
                                              <p:Literal x:TypeArguments="x:String" Value="" />
                                            </p:InArgument>
                                          </jesw1:JHAAssign.Value>
                                        </jesw1:JHAAssign>
                                        <jesw1:JHAAssign DesignerErrors="{x:Null}" ReportableDetails="{x:Null}" DisplayName="Assign" sap2010:WorkflowViewState.IdRef="JHAAssign_8" InternalIdentifierKey="00000000-0000-0000-0000-000000000000">
                                          <jesw1:JHAAssign.To>
                                            <p:OutArgument x:TypeArguments="x:String">[RsStat]</p:OutArgument>
                                          </jesw1:JHAAssign.To>
                                          <jesw1:JHAAssign.Value>
